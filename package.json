{
  "name": "finanzas-local-first",
  "version": "0.1.0",
  "private": true,
  "description": "Gestión y planificación de gastos local-first (Clean/Hexagonal Architecture + DDD)",
  "type": "module",
  "scripts": {
    "prepare:assets": "tsx scripts/embed-migrations.ts && tsx scripts/copy-sqljs.ts",
    "predev": "npm run prepare:assets",
    "dev": "next dev",
    "prebuild": "npm run prepare:assets",
    "build": "next build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate && tsx scripts/embed-migrations.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
