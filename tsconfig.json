{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "paths": {
      "@frontend/*": ["./frontend/*"],
      "@backend/*": ["./backend/*"]
    }
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "backend/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "frontend/.next", "frontend/out"]
}
